    <HookInstance>
      <ItemName>DocumentOpened</ItemName>
      <Compatibility/>
      <Visible>1</Visible>
      <PartID>725374975</PartID>
      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Sub DocumentOpened(item As FolderItem)</SourceLine>
        <SourceLine>If item &lt;&gt; Nil Then</SourceLine>
        <SourceLine>MainWindow.MovieFilenameTextField.Text = item.NativePath</SourceLine>
        <SourceLine>Var InputMovieFP As FolderItem</SourceLine>
        <SourceLine>Try</SourceLine>
        <SourceLine>InputMovieFP  = New FolderItem(item.NativePath, FolderItem.PathModes.Shell)</SourceLine>
        <SourceLine>If InputMovieFP &lt;&gt; Nil  and InputMovieFP.Exists = True Then</SourceLine>
        <SourceLine>MainWindow.MoviePlayer1.Movie = Movie.Open(InputMovieFP)</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>MessageBox("File Missing: " + EndOfLine + "Please select a movie file and then preview the video again.")</SourceLine>
        <SourceLine>return</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Catch e As UnsupportedFormatException</SourceLine>
        <SourceLine>return</SourceLine>
        <SourceLine>End Try</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>End Sub</SourceLine>
      </ItemSource>
    </HookInstance>
