    <ControlBehavior>
      <Superclass>Timer</Superclass>
      <HookInstance>
        <ItemName>Action</ItemName>
        <Compatibility/>
        <Visible>1</Visible>
        <PartID>1363843071</PartID>
        <ItemSource>
          <TextEncoding>134217984</TextEncoding>
          <SourceLine>Sub Action()</SourceLine>
          <SourceLine>If InteractiveShell &lt;&gt; Nil Then</SourceLine>
          <SourceLine>// Display shell output</SourceLine>
          <SourceLine>Var output As String = InteractiveShell.ReadAll</SourceLine>
          <SourceLine/>
          <SourceLine>// Check if there is new data available</SourceLine>
          <SourceLine>If Not output.IsEmpty Then</SourceLine>
          <SourceLine>// Update the console log</SourceLine>
          <SourceLine>OutputArea.Text = OutputArea.Text + output</SourceLine>
          <SourceLine/>
          <SourceLine>// Scroll to bottom</SourceLine>
          <SourceLine>OutputArea.VerticalScrollPosition = OutputArea.LineNumber(OutputArea.Text.Length)</SourceLine>
          <SourceLine/>
          <SourceLine>// Find the progress info</SourceLine>
          <SourceLine>Var regex As New RegEx</SourceLine>
          <SourceLine>Var match As RegExMatch</SourceLine>
          <SourceLine>Var result As String</SourceLine>
          <SourceLine>Var progress As Integer = 0</SourceLine>
          <SourceLine/>
          <SourceLine>regex.SearchPattern = "progress=\s*(\d+\.\d+)%"</SourceLine>
          <SourceLine>match = regex.Search(output)</SourceLine>
          <SourceLine/>
          <SourceLine>Do</SourceLine>
          <SourceLine>If match &lt;&gt; Nil Then</SourceLine>
          <SourceLine>result = match.SubExpressionString(1)</SourceLine>
          <SourceLine>progress = result.ToInteger</SourceLine>
          <SourceLine/>
          <SourceLine>RenderProgressBar.Value = progress</SourceLine>
          <SourceLine>RenderProgressBar.Refresh(True)</SourceLine>
          <SourceLine>// System.DebugLog(result)</SourceLine>
          <SourceLine>If progress = 100 Then</SourceLine>
