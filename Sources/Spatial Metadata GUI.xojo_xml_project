      <PartID>672129023</PartID>
      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Sub DropObject(obj As DragItem, action As DragItem.Types)</SourceLine>
        <SourceLine>If Obj.FolderItemAvailable Then </SourceLine>
        <SourceLine>MovieFilenameTextField.Text = obj.FolderItem.NativePath</SourceLine>
        <SourceLine>Var InputMovieFP As FolderItem</SourceLine>
        <SourceLine>Try</SourceLine>
        <SourceLine>InputMovieFP  = New FolderItem(obj.FolderItem.NativePath, FolderItem.PathModes.Shell)</SourceLine>
        <SourceLine>If InputMovieFP &lt;&gt; Nil  and InputMovieFP.Exists = True Then</SourceLine>
        <SourceLine>MoviePlayer1.Movie = Movie.Open(InputMovieFP)</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>MessageBox("File Missing: " + EndOfLine + "Please select a movie file and then preview the video again.")</SourceLine>
        <SourceLine>return</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Catch e As UnsupportedFormatException</SourceLine>
        <SourceLine>return</SourceLine>
        <SourceLine>End Try</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>End Sub</SourceLine>
      </ItemSource>
    </HookInstance>
    <HookInstance>
      <ItemName>Closing</ItemName>
      <Compatibility/>
      <Visible>1</Visible>
      <PartID>258050047</PartID>
      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Sub Closing()</SourceLine>
        <SourceLine>// Window Closing Event Handler</SourceLine>
        <SourceLine>Var programName As String = App.ExecutableFile.Name + ".json"</SourceLine>
        <SourceLine/>
        <SourceLine>// Create the  prefs folder</SourceLine>
        <SourceLine>Var prefsFolder As FolderItem = SpecialFolder.ApplicationData.Child("Kartaverse")</SourceLine>
        <SourceLine>Try</SourceLine>
        <SourceLine>If prefsFolder.Exists = False Then</SourceLine>
        <SourceLine>prefsFolder.CreateFolder</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Catch e As IOException</SourceLine>
        <SourceLine>// Handle error</SourceLine>
        <SourceLine>End Try</SourceLine>
        <SourceLine/>
        <SourceLine>// Create the Spatial Metadata GUI.json file in the prefs folder</SourceLine>
        <SourceLine>Var prefsFile As FolderItem = prefsFolder.Child(programName)</SourceLine>
        <SourceLine>Var fileStream As TextOutputStream</SourceLine>
        <SourceLine>If prefsFile &lt;&gt; Nil Then</SourceLine>
        <SourceLine>Try</SourceLine>
        <SourceLine>// Create the file pointer</SourceLine>
        <SourceLine>fileStream = TextOutputStream.Create(prefsFile)</SourceLine>
        <SourceLine/>
        <SourceLine>// Create a new JSON object hierarchy</SourceLine>
        <SourceLine>Var json As New JSONItem</SourceLine>
        <SourceLine>json.Value("ImageProjection") = ImageProjectionComboBox.Text</SourceLine>
        <SourceLine>json.Value("StereoFormat") = StereoFormatComboBox.Text</SourceLine>
        <SourceLine>json.Value("PrimaryEye") = PrimaryEyeComboBox.Text </SourceLine>
        <SourceLine>json.Value("HFOV") = HFOVTextField.Text </SourceLine>
        <SourceLine>json.Value("InteraxialLensSeparation") = InteraxialLensSeparationTextField.Text</SourceLine>
        <SourceLine>json.Value("HAdjust") = HAdjustTextField.Text</SourceLine>
        <SourceLine>json.Value("Faststart") = FaststartCheckBox.Value</SourceLine>
        <SourceLine>json.Value("AutoBitrate") = AutoBitrateCheckBox.Value</SourceLine>
        <SourceLine>json.Value("Bitrate") = BitrateTextField.Text</SourceLine>
        <SourceLine>json.Compact = False</SourceLine>
        <SourceLine/>
        <SourceLine>// Write the data to disk</SourceLine>
        <SourceLine>fileStream.WriteLine(json.ToString)</SourceLine>
        <SourceLine/>
        <SourceLine>// Close the filepointer</SourceLine>
        <SourceLine>fileStream.Close</SourceLine>
        <SourceLine>Catch e As IOException</SourceLine>
        <SourceLine>// Handle error</SourceLine>
        <SourceLine>End Try</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>End Sub</SourceLine>
      </ItemSource>
    </HookInstance>
