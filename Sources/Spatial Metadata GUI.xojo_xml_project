    <ControlBehavior>
      <Superclass>DesktopButton</Superclass>
      <HookInstance>
        <ItemName>Pressed</ItemName>
        <Compatibility/>
        <Visible>1</Visible>
        <PartID>1475512319</PartID>
        <ItemSource>
          <TextEncoding>134217984</TextEncoding>
          <SourceLine>Sub Pressed()</SourceLine>
          <SourceLine>Var sh As New Shell</SourceLine>
          <SourceLine>Var Commands As String</SourceLine>
          <SourceLine/>
          <SourceLine>// Output the number content as English-US for the CLI</SourceLine>
          <SourceLine>Var currentLocale As Locale = Locale.Current</SourceLine>
          <SourceLine>Var USEnglishLocale As New Locale("en-US")</SourceLine>
          <SourceLine/>
          <SourceLine>// Format numbers using alternative thousands and decimal separators</SourceLine>
          <SourceLine>Var decimal As String = currentLocale.DecimalSeparator</SourceLine>
          <SourceLine/>
          <SourceLine>// Program Info</SourceLine>
          <SourceLine>Var header As String </SourceLine>
          <SourceLine>header = "[Spatial Metadata] v1.4" + EndOfLine</SourceLine>
          <SourceLine>header = header + "GUI by Andrew Hazelden &lt;andrew@andrewhazelden.com&gt;" + EndOfLine</SourceLine>
          <SourceLine>header = header + "Powered by the Spatial CLI tool by Mike Swanson" + EndOfLine</SourceLine>
          <SourceLine>header = header + "[Localization Settings] [Locale] " + currentLocale.Identifier + " [Decimal Character] " + decimal +  EndOfLine</SourceLine>
          <SourceLine/>
          <SourceLine>// Spatial program filepath</SourceLine>
          <SourceLine>Var SpatialProgram As String = "/opt/homebrew/bin/spatial"</SourceLine>
          <SourceLine>Var SFP As FolderItem = New FolderItem(SpatialProgram, FolderItem.PathModes.Shell)</SourceLine>
          <SourceLine/>
          <SourceLine>// Variables</SourceLine>
          <SourceLine>Var i As Integer = 1</SourceLine>
          <SourceLine>Var doubleInteraxialLensSeparation As Double = Double.FromString(InteraxialLensSeparationTextField.Text, currentLocale)</SourceLine>
          <SourceLine>Var InteraxialLensSeparation As String = doubleInteraxialLensSeparation.ToString(USEnglishLocale, "##.###")</SourceLine>
          <SourceLine/>
          <SourceLine>Var doubleHFOV As Double = Double.FromString(HFOVTextField.Text, currentLocale)</SourceLine>
          <SourceLine>Var HFOV As String = doubleHFOV.ToString(USEnglishLocale, "###.##")</SourceLine>
          <SourceLine/>
          <SourceLine>Var doubleHAdjust As Double = Double.FromString(HAdjustTextField.Text , currentLocale)</SourceLine>
          <SourceLine>Var HAdjust As String = doubleHAdjust.ToString(USEnglishLocale, "#.####")</SourceLine>
          <SourceLine/>
          <SourceLine>Var PrimaryEye As String = PrimaryEyeComboBox.Text.Lowercase</SourceLine>
          <SourceLine>Var AutoBitrate As Boolean = AutoBitrateCheckBox.Value</SourceLine>
          <SourceLine/>
          <SourceLine>Var ImageProjection As String</SourceLine>
          <SourceLine>If ImageProjectionComboBox.Text = "" Then</SourceLine>
          <SourceLine>// Fallback 1</SourceLine>
          <SourceLine>ImageProjection = "halfEquirect"</SourceLine>
          <SourceLine>Elseif ImageProjectionComboBox.Text = "180VR" Then</SourceLine>
          <SourceLine>ImageProjection = "halfEquirect"</SourceLine>
          <SourceLine>Elseif ImageProjectionComboBox.Text = "360VR" Then</SourceLine>
          <SourceLine>ImageProjection = "equirect"</SourceLine>
          <SourceLine>Elseif ImageProjectionComboBox.Text = "Fisheye" Then</SourceLine>
          <SourceLine>ImageProjection = "fisheye"</SourceLine>
          <SourceLine>Elseif ImageProjectionComboBox.Text = "Flat" Then</SourceLine>
          <SourceLine>ImageProjection = "rect"</SourceLine>
          <SourceLine>Else</SourceLine>
          <SourceLine>// Fallback 2</SourceLine>
          <SourceLine>ImageProjection = "halfEquirect"</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>Var Format As String = ""</SourceLine>
          <SourceLine>If StereoFormatComboBox.Text = "" Then</SourceLine>
          <SourceLine>// Fallback 1</SourceLine>
          <SourceLine>Format = "sbs"</SourceLine>
          <SourceLine>Elseif StereoFormatComboBox.Text = "Side By Side" Then</SourceLine>
          <SourceLine>Format = "sbs"</SourceLine>
          <SourceLine>Elseif StereoFormatComboBox.Text = "Over Under" Then</SourceLine>
          <SourceLine>Format = "ou"</SourceLine>
          <SourceLine>Else</SourceLine>
          <SourceLine>// Fallback 2</SourceLine>
          <SourceLine>Format = "sbs"</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>Var doubleBitRateMbps As double = Double.FromString(BitrateTextField.Text, currentLocale)</SourceLine>
          <SourceLine>Var BitRateMbps As String</SourceLine>
          <SourceLine>If AutoBitrateCheckBox.Value = False Then</SourceLine>
          <SourceLine>//  Use manual data rates when the checkbox is disabled</SourceLine>
          <SourceLine>BitRateMbps = " --bitrate=" + doubleBitRateMbps.ToString(USEnglishLocale, "#######.00") +"M "</SourceLine>
          <SourceLine>Else</SourceLine>
          <SourceLine>// Use automatic data rates when the checkbox is enabled</SourceLine>
          <SourceLine>BitRateMbps = ""</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>Var overwrite As String</SourceLine>
          <SourceLine>If OverwriteFilesCheckBox.Value = True Then</SourceLine>
          <SourceLine>overwrite = " --overwrite "</SourceLine>
          <SourceLine>Else</SourceLine>
          <SourceLine>overwrite = ""</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>Var faststart As String</SourceLine>
          <SourceLine>If FaststartCheckBox.Value = True Then</SourceLine>
          <SourceLine>faststart = " --faststart "</SourceLine>
          <SourceLine>Else</SourceLine>
          <SourceLine>faststart = ""</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>If SFP.Exists = False Then</SourceLine>
          <SourceLine>header = header + "[Status][Error] The Spatial CLI program was not found. Please install it before running this script again." + EndOfLine + EndOfLine</SourceLine>
          <SourceLine/>
          <SourceLine>header = header + "The Spatial CLI program can be installed using the macOS based homebrew package manager." + EndOfLine + EndOfLine</SourceLine>
          <SourceLine/>
          <SourceLine>header = header + "# Install Homebrew using the macOS terminal:" + EndOfLine</SourceLine>
          <SourceLine>header = header + "/bin/bash -c ""$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)""" + EndOfLine + EndOfLine</SourceLine>
          <SourceLine/>
          <SourceLine>header = header + "# Install the Spatial CLI app using the brew program in the macOS terminal:" + EndOfLine</SourceLine>
          <SourceLine>header = header + "brew install spatial" + EndOfLine + EndOfLine</SourceLine>
          <SourceLine/>
          <SourceLine>header = header + "# The Spatial CLI app now lives on your hard disk at:" + EndOfLine</SourceLine>
          <SourceLine>header = header + "/opt/homebrew/bin/spatial" + EndOfLine + EndOfLine</SourceLine>
          <SourceLine/>
          <SourceLine>OutputArea.Text = header</SourceLine>
          <SourceLine>return</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>// Process each video clip</SourceLine>
          <SourceLine>Var InputMovie As String = MovieFilenameTextField.Text</SourceLine>
          <SourceLine>Var InputMovieFP As FolderItem</SourceLine>
          <SourceLine>Var InputMovieExt As String</SourceLine>
          <SourceLine>Var OutputMovie As String</SourceLine>
          <SourceLine/>
          <SourceLine>Try</SourceLine>
          <SourceLine>If InputMovie.Length &gt; 1 Then</SourceLine>
          <SourceLine>InputMovieFP  = New FolderItem(InputMovie, FolderItem.PathModes.Shell)</SourceLine>
          <SourceLine>If InputMovieFP.Exists = True Then</SourceLine>
          <SourceLine>InputMovieExt = InputMovieFP.Extension</SourceLine>
          <SourceLine>OutputMovie = InputMovie.TrimRight("." + InputMovieExt)  + "_injected.mov"</SourceLine>
          <SourceLine>header = header + EndOfLine + "[Clip #] " + i.ToString + EndOfLine </SourceLine>
          <SourceLine>header = header +  "[Input Filename] " + EndOfLine + InputMovie + EndOfLine  + EndOfLine </SourceLine>
          <SourceLine/>
          <SourceLine>header = header + "[Output Filename] " + EndOfLine + OutputMovie + EndOfLine + EndOfLine</SourceLine>
          <SourceLine>Else</SourceLine>
          <SourceLine>header = header + EndOfLine + "[Clip #] " + i.ToString + EndOfLine </SourceLine>
          <SourceLine>header = header +  "[Input File Missing] " + EndOfLine + InputMovie + EndOfLine</SourceLine>
          <SourceLine>OutputArea.Text = header</SourceLine>
          <SourceLine>MessageBox("File Missing: " + EndOfLine + "Please select a movie file and then encode the video again.")</SourceLine>
          <SourceLine>return</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>Else</SourceLine>
          <SourceLine>header = header + EndOfLine + "[Clip #] " + i.ToString + EndOfLine</SourceLine>
          <SourceLine>header = header + "[Input File Missing] " + EndOfLine + InputMovie + EndOfLine</SourceLine>
          <SourceLine>OutputArea.Text = header</SourceLine>
          <SourceLine>MessageBox("[File Missing]" + EndOfLine + "Please select a movie file and then encode the video again.")</SourceLine>
          <SourceLine>return</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine>Catch e As UnsupportedFormatException</SourceLine>
          <SourceLine>header = header + "[Input Filename Empty] "  + EndOfLine + EndOfLine + e.Message</SourceLine>
          <SourceLine>OutputArea.Text = header</SourceLine>
          <SourceLine>MessageBox("[File Missing]" + EndOfLine + "Please select a movie file and then encode the video again.")</SourceLine>
          <SourceLine>return</SourceLine>
          <SourceLine>End Try</SourceLine>
          <SourceLine/>
          <SourceLine>// CLI String</SourceLine>
          <SourceLine>Var Options As String = "make " + faststart + overwrite + " --input=""" + InputMovie + """ --format=""" + Format + """ --output=""" + OutputMovie + """ --cdist=""" + InteraxialLensSeparation + """ --hfov=""" + HFOV +  """ --hadjust=""" + HAdjust + """ --primary=""" + PrimaryEye + """ --projection=" + ImageProjection + BitRateMbps</SourceLine>
          <SourceLine>Commands = """" + SpatialProgram + """ " + Options</SourceLine>
          <SourceLine>header = header + "[Command Line]" + EndOfLine + commands + EndOfLine</SourceLine>
          <SourceLine>OutputArea.Text = header</SourceLine>
          <SourceLine/>
          <SourceLine>If Not InteractiveShell.IsRunning Then</SourceLine>
          <SourceLine>#If TargetWindows Then</SourceLine>
          <SourceLine>InteractiveShell.Execute(Commands)</SourceLine>
          <SourceLine>#Else</SourceLine>
          <SourceLine>InteractiveShell.Execute("PATH=" + System.EnvironmentVariable("PATH")+":/opt/homebrew/bin/") // Sets the PATH env variable in the shell</SourceLine>
          <SourceLine>InteractiveShell.Execute("zsh")</SourceLine>
          <SourceLine>#Endif</SourceLine>
          <SourceLine>End If</SourceLine>
          <SourceLine/>
          <SourceLine>InteractiveShell.WriteLine(Commands)</SourceLine>
          <SourceLine>InputField.Text = ""</SourceLine>
          <SourceLine>InputField.SetFocus</SourceLine>
          <SourceLine/>
          <SourceLine>// End of listbox looping</SourceLine>
          <SourceLine/>
          <SourceLine>End Sub</SourceLine>
        </ItemSource>
      </HookInstance>
    </ControlBehavior>
