    <HookInstance>
      <ItemName>Opening</ItemName>
      <Compatibility/>
      <Visible>1</Visible>
      <PartID>1903702015</PartID>
      <ItemSource>
        <TextEncoding>134217984</TextEncoding>
        <SourceLine>Sub Opening()</SourceLine>
        <SourceLine>self.AcceptFileDrop("Special/Any") </SourceLine>
        <SourceLine/>
        <SourceLine>// Format numbers using alternative thousands and decimal separators</SourceLine>
        <SourceLine>Var currentLocale As Locale = Locale.Current</SourceLine>
        <SourceLine>Var decimal As String = currentLocale.DecimalSeparator</SourceLine>
        <SourceLine/>
        <SourceLine>// Window Opening Event Handler</SourceLine>
        <SourceLine>Var programName As String = App.ExecutableFile.Name + ".json"</SourceLine>
        <SourceLine/>
        <SourceLine>// Create the prefs folder</SourceLine>
        <SourceLine>Var prefsFolder As FolderItem = SpecialFolder.ApplicationData.Child("Kartaverse")</SourceLine>
        <SourceLine>Try</SourceLine>
        <SourceLine>If prefsFolder.Exists = False Then</SourceLine>
        <SourceLine>prefsFolder.CreateFolder</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine>Catch e As IOException</SourceLine>
        <SourceLine>// Handle error</SourceLine>
        <SourceLine>End Try</SourceLine>
        <SourceLine/>
        <SourceLine>// Read the Spatial Metadata GUI.json file from the prefs folder</SourceLine>
        <SourceLine>Var prefsFile As FolderItem = prefsFolder.Child(programName)</SourceLine>
        <SourceLine>If prefsFile &lt;&gt; Nil and prefsFile.Exists = True Then</SourceLine>
        <SourceLine>Try</SourceLine>
        <SourceLine>// Create the file pointer</SourceLine>
        <SourceLine>Var fileStream As TextInputStream = TextInputStream.Open(prefsFile)</SourceLine>
        <SourceLine/>
        <SourceLine>// Read the full text file in one block</SourceLine>
        <SourceLine>Var textData As String = fileStream.ReadAll</SourceLine>
        <SourceLine>// MessageBox(textData)</SourceLine>
        <SourceLine>Try</SourceLine>
        <SourceLine>//Create a new JSON object hierarchy</SourceLine>
        <SourceLine>Var json As New JSONItem(textData)</SourceLine>
        <SourceLine>json.Compact = False</SourceLine>
        <SourceLine>Var val As String</SourceLine>
        <SourceLine/>
        <SourceLine>// Load the JSON values</SourceLine>
        <SourceLine>ImageProjectionComboBox.Text = json.Value("ImageProjection")</SourceLine>
        <SourceLine>StereoFormatComboBox.Text =  json.Value("StereoFormat")</SourceLine>
        <SourceLine>PrimaryEyeComboBox.Text = json.Value("PrimaryEye")</SourceLine>
        <SourceLine>HFOVTextField.Text = json.Value("HFOV")</SourceLine>
        <SourceLine>InteraxialLensSeparationTextField.Text = json.Value("InteraxialLensSeparation")</SourceLine>
        <SourceLine>HAdjustTextField.Text = json.Value("HAdjust")</SourceLine>
        <SourceLine>AutoBitrateCheckBox.Value = json.Value("AutoBitrate")</SourceLine>
        <SourceLine>BitrateTextField.Text = json.Value("Bitrate")</SourceLine>
        <SourceLine>FaststartCheckBox.Value = json.Value("Faststart")</SourceLine>
        <SourceLine/>
        <SourceLine>// MessageBox(json.ToString)</SourceLine>
        <SourceLine>Catch e As JSONException</SourceLine>
        <SourceLine>// Fallback</SourceLine>
        <SourceLine>ImageProjectionComboBox.Text = "180VR"</SourceLine>
        <SourceLine>StereoFormatComboBox.Text = "Side By Side"</SourceLine>
        <SourceLine>PrimaryEyeComboBox.Text = "Left"</SourceLine>
        <SourceLine>HFOVTextField.Text = "180"</SourceLine>
        <SourceLine>InteraxialLensSeparationTextField.Text = "64"</SourceLine>
        <SourceLine>HAdjustTextField.Text = "0"</SourceLine>
        <SourceLine>AutoBitrateCheckBox.Value = True</SourceLine>
        <SourceLine>Catch k As KeyNotFoundException</SourceLine>
        <SourceLine>// Fallback</SourceLine>
        <SourceLine>ImageProjectionComboBox.Text = "180VR"</SourceLine>
        <SourceLine>StereoFormatComboBox.Text = "Side By Side"</SourceLine>
        <SourceLine>PrimaryEyeComboBox.Text = "Left"</SourceLine>
        <SourceLine>HFOVTextField.Text = "180"</SourceLine>
        <SourceLine>InteraxialLensSeparationTextField.Text = "64"</SourceLine>
        <SourceLine>HAdjustTextField.Text = "0"</SourceLine>
        <SourceLine>AutoBitrateCheckBox.Value = True</SourceLine>
        <SourceLine>End Try</SourceLine>
        <SourceLine>Catch e As IOException</SourceLine>
        <SourceLine>// Handle error</SourceLine>
        <SourceLine>ImageProjectionComboBox.Text = "180VR"</SourceLine>
        <SourceLine>StereoFormatComboBox.Text = "Side By Side"</SourceLine>
        <SourceLine>PrimaryEyeComboBox.Text = "Left"</SourceLine>
        <SourceLine>HFOVTextField.Text = "180"</SourceLine>
        <SourceLine>InteraxialLensSeparationTextField.Text = "64"</SourceLine>
        <SourceLine>HAdjustTextField.Text = "0"</SourceLine>
        <SourceLine>AutoBitrateCheckBox.Value = True</SourceLine>
        <SourceLine>Catch e As JSONException</SourceLine>
        <SourceLine>// Fallback</SourceLine>
        <SourceLine>ImageProjectionComboBox.Text = "180VR"</SourceLine>
        <SourceLine>StereoFormatComboBox.Text = "Side By Side"</SourceLine>
        <SourceLine>PrimaryEyeComboBox.Text = "Left"</SourceLine>
        <SourceLine>HFOVTextField.Text = "180"</SourceLine>
        <SourceLine>InteraxialLensSeparationTextField.Text = "64"</SourceLine>
        <SourceLine>HAdjustTextField.Text = "0"</SourceLine>
        <SourceLine>AutoBitrateCheckBox.Value = True</SourceLine>
        <SourceLine>End Try</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>// Fallback</SourceLine>
        <SourceLine>ImageProjectionComboBox.Text = "180VR"</SourceLine>
        <SourceLine>StereoFormatComboBox.Text = "Side By Side"</SourceLine>
        <SourceLine>PrimaryEyeComboBox.Text = "Left"</SourceLine>
        <SourceLine>HFOVTextField.Text = "180"</SourceLine>
        <SourceLine>InteraxialLensSeparationTextField.Text = "64"</SourceLine>
        <SourceLine>HAdjustTextField.Text = "0"</SourceLine>
        <SourceLine>AutoBitrateCheckBox.Value = True</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>// Show range values with correct decimal separator</SourceLine>
        <SourceLine>HAdjustLabel.Text = "Horizonal Disparity Adjustment (-1" + decimal + "0 to 1"+ decimal + "0):"</SourceLine>
        <SourceLine/>
        <SourceLine>// Format the text field values</SourceLine>
        <SourceLine>'HFOVTextField.Format = "###" + decimal + "##"</SourceLine>
        <SourceLine>'InteraxialLensSeparationTextField.Format = "##" + decimal + "###"</SourceLine>
        <SourceLine>'HAdjustTextField.Format = "-#" + decimal + "####"</SourceLine>
        <SourceLine>'BitrateTextField.Format = "#######" + decimal + "00"</SourceLine>
        <SourceLine/>
        <SourceLine>// Program Info</SourceLine>
        <SourceLine>Var header As String </SourceLine>
        <SourceLine>header = "[Spatial Metadata] v1.4" + EndOfLine</SourceLine>
        <SourceLine>header = header + "GUI by Andrew Hazelden &lt;andrew@andrewhazelden.com&gt;" + EndOfLine</SourceLine>
        <SourceLine>header = header + "Powered by the Spatial CLI tool by Mike Swanson" + EndOfLine</SourceLine>
        <SourceLine>header = header + "[Localization Settings] [Locale] " + currentLocale.Identifier + " [Decimal Character] " + decimal +  EndOfLine</SourceLine>
        <SourceLine>OutputArea.Text = header</SourceLine>
        <SourceLine/>
        <SourceLine>InteractiveShell = New Shell</SourceLine>
        <SourceLine>InteractiveShell.ExecuteMode = Shell.ExecuteModes.Interactive</SourceLine>
        <SourceLine/>
        <SourceLine>#If not TargetWindows Then</SourceLine>
        <SourceLine>// Sets the PATH env variable in the shell</SourceLine>
        <SourceLine>InteractiveShell.Execute("PATH=" + System.EnvironmentVariable("PATH")+":/opt/homebrew/bin/")</SourceLine>
        <SourceLine>#Endif</SourceLine>
        <SourceLine/>
        <SourceLine>If AutoBitrateCheckBox.Value = False Then</SourceLine>
        <SourceLine>// Show the bitrate text field when the checkbox is disabled</SourceLine>
        <SourceLine>BitrateTextField.Visible = True</SourceLine>
        <SourceLine>BitrateLabel.Visible = True</SourceLine>
        <SourceLine>Else</SourceLine>
        <SourceLine>// Hide the bitrate text field when the checkbox is disabled</SourceLine>
        <SourceLine>BitrateTextField.Visible = False</SourceLine>
        <SourceLine>BitrateLabel.Visible = False</SourceLine>
        <SourceLine>End If</SourceLine>
        <SourceLine/>
        <SourceLine>End Sub</SourceLine>
      </ItemSource>
    </HookInstance>
